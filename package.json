{
  "name": "greencode",
  "version": "2.0.0",
  "description": "Sistema monolítico RESTful de gestão de logística reversa de resíduos eletrônicos (GreenCode AV2)",
  "main": "dist/src/http/server.js",
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/http/server.js",
    "cli": "tsx src/cli.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "test": "tsx tests/api.integration.test.ts",
    "test:cli": "tsx tests/simulate.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
